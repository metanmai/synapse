# Synapse proxy Layer 8 E2E — Debian 12 trust-store install test.
# Spec §4.2: debian-family install to /usr/local/share/ca-certificates/synapse.crt
# + update-ca-certificates → /etc/ssl/certs/synapse.pem symlink.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      sudo \
      openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
COPY . /repo

# npm workspaces: install from the workspace root (--workspace=mcp scopes
# the install to just mcp + its workspace deps; --include-workspace-root=false
# skips root deps so the image stays lean).
RUN npm install --workspace=mcp --include-workspace-root=false --no-audit --no-fund

WORKDIR /repo/mcp
RUN npm run build

ENTRYPOINT ["/bin/sh", "/repo/scripts/e2e-linux/e2e-proxy-install.sh"]
