# Synapse proxy Layer 8 E2E — Rocky Linux 9 trust-store install test.
# Spec §4.2: rhel-family via ID_LIKE="rhel centos fedora" inheritance —
# exercises the os-release parser on a distro that names rhel in ID_LIKE
# rather than ID. Mirror test for Ubuntu (ID_LIKE=debian).
FROM rockylinux:9

# Rocky 9 ships curl-minimal preinstalled. Don't install `curl` — it
# conflicts with curl-minimal at the file-provides level. curl-minimal
# provides the `curl` binary we need for the NodeSource setup script.
RUN dnf install -y \
      ca-certificates \
      sudo \
      openssl \
 && curl -fsSL https://rpm.nodesource.com/setup_24.x | bash - \
 && dnf install -y nodejs \
 && dnf clean all

WORKDIR /repo
COPY . /repo

RUN npm install --workspace=mcp --include-workspace-root=false --no-audit --no-fund

WORKDIR /repo/mcp
RUN npm run build

ENTRYPOINT ["/bin/sh", "/repo/scripts/e2e-linux/e2e-proxy-install.sh"]
