{
  "name": "synapse",
  "private": true,
  "workspaces": ["packages/*", "backend", "frontend", "mcp"],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run lint && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e-happy-flow.mjs",
    "test:e2e:failures": "node scripts/e2e-failure-cases.mjs",
    "test:e2e:all": "node scripts/e2e-happy-flow.mjs && node scripts/e2e-failure-cases.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0"
  }
}
