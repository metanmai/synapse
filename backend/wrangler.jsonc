// Last manually-triggered deploy: 2026-05-20 (defensive Promise.allSettled
// swap from commit 16a4de1; CF git integration hadn't fired in 14h).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synapse",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SynapseAgent",
        "name": "MCP_OBJECT"
      },
      {
        "class_name": "CompactionScheduler",
        "name": "COMPACTION_SCHEDULER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["SynapseAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["CompactionScheduler"],
      "tag": "v2"
    }
  ],
  "routes": [{ "pattern": "api.synapsesync.app", "custom_domain": true }],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // ADMIN_SECRET, CREEM_PRO_PRODUCT_ID, EMBEDDING_SERVICE_URL, EMBEDDING_SERVICE_KEY,
  // SUPABASE_URL, SUPABASE_SERVICE_KEY are all set via `wrangler secret put` —
  // do NOT define them as vars here or they will be overwritten with empty
  // values on every deploy.
  // COMPACTION_LLM_KEY is set via `wrangler secret put`
  // SENTRY_DSN is set via `wrangler secret put SENTRY_DSN` before deploy.
  "vars": {
    "COMPACTION_LLM_MODEL": "claude-haiku-4-5-20251001"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
